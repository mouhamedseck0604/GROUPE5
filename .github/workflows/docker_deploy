name: CI/CD Docker Deploy with SCP

on:
  push:
    branches:
      - main

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      # 1. Récupérer ton code
      - name: Checkout code
        uses: actions/checkout@v4

      # 2. Copier les fichiers vers le serveur distant
      - name: Copy files via SCP
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ${{ secrets.EC2_USER }}
          key: ${{ secrets.EC2_SSH_KEY }}
          source: "."
          target: "/home/${{ secrets.EC2_USER }}/GROUPE5"

      # 3. Construire et lancer le conteneur sur le serveur
      - name: Deploy with SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ${{ secrets.EC2_USER }}
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            cd /home/${{ secrets.EC2_USER }}/GROUPE5
            docker stop flask_app1 || true
            docker rm flask_app1 || true
            docker build -t flask_app1 .
            docker run -d -p 5005:5005 flask_app1
